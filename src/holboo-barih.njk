---
layout: layouts/base.njk
title: Холбоо барих
description: Ганзо Сургалтын холбоо барих мэдээлэл. Сургалт, бүртгэл, төлбөрийн талаар асуух.
permalink: /holboo-barih/
---
{%- from "partials/macros.njk" import pageHero with context %}
{{ pageHero("Холбоо барих", "Холбоо барих", "Сургалт, бүртгэл, төлбөрийн талаар доорх хаягаар холбогдоно уу.") }}

<section class="section">
  <div class="container contact-grid">
    {%- if site.phones and site.phones.length %}
    <div class="contact-card">
      <p class="contact-label">Утас</p>
      <p class="contact-value">{% for p in site.phones %}<a href="{{ p | telHref }}">{{ p }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
    </div>
    {%- endif %}
    {%- if site.email %}
    <div class="contact-card">
      <p class="contact-label">Имэйл</p>
      <p class="contact-value"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <button type="button" class="link-small copy-btn" data-copy="{{ site.email }}">Имэйл хаягийг хуулах</button>
    </div>
    {%- endif %}
    {%- if site.youtube_channel %}
    <div class="contact-card">
      <p class="contact-label">YouTube</p>
      <p class="contact-value"><a href="{{ site.youtube_channel }}" rel="noopener" target="_blank">Үнэгүй бичлэгүүд</a></p>
    </div>
    {%- endif %}
    {%- if site.address %}
    <div class="contact-card">
      <p class="contact-label">Хаяг</p>
      <p class="contact-value">{{ site.address }}</p>
      {%- if site.map_url %}<a class="link-small" href="{{ site.map_url }}" rel="noopener" target="_blank">Газрын зураг дээр харах</a>{% endif %}
    </div>
    {%- endif %}
  </div>
  {%- if site.map_embed %}
  <div class="container">
    <div class="map-wrap">
      <iframe class="map-frame" src="{{ site.map_embed }}" title="Сургалтын байршил" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </div>
  {%- endif %}
  <div class="container">
    <p class="steps-cta"><a class="btn btn-primary" href="/burtguuleh/">Сургалтад бүртгүүлэх</a></p>
  </div>
</section>

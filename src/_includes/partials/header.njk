<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }}, нүүр хуудас">
      <img class="brand-mark" src="/assets/img/mark.svg" width="40" height="40" alt="">
      <span class="brand-text">
        <span class="brand-name">{{ site.brand }} <span class="brand-academy">{{ site.brandSub }}</span></span>
        <span class="brand-sub">Нягтлан бодогч, санхүүчдэд</span>
      </span>
    </a>
    <div class="header-tools">
      {%- if site.youtube_channel %}<a class="hdr-yt" href="{{ site.youtube_channel }}" rel="noopener" target="_blank" aria-label="YouTube суваг"><svg class="ico" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.8 15V9l5.7 3-5.7 3z"/></svg><span>YouTube</span></a>{% endif %}
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Цэс нээх">
        <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="nav-toggle-label">Цэс</span>
      </button>
    </div>
    <nav class="site-nav" id="site-nav" aria-label="Үндсэн цэс">
      <ul>
        {%- for item in navigation %}
        {%- set active = (page.url == item.url) or (item.url != "/" and (page.url | string).startsWith(item.url)) %}
        {%- set isCta = (item.url == "/burtguuleh/") %}
        <li{% if item.url == "/" %} class="nav-home"{% endif %}><a href="{{ item.url }}"{% if isCta %} class="nav-cta"{% endif %}{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
